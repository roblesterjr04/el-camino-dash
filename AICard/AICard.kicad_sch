  (text "AI VOICE CARD  -  ESP32-S3-WROOM-1U-N16R8 front end + compute module on a 2 x 20 header (Linux: speech, on-board model, online lookups) + MCP2562 CAN" (at 15 12 0) (effects (font (size 3 3)) (justify left top)) (uuid "0f505092-82c1-59ee-8d64-60ebb7ddee6f"))
  (text "Card for a DigiDash slot, 80 x 60 mm, standing on edge (docs/hardware/accessory_ports.md, docs/hardware/ai_card.md). Any slot. CAN node 0x14 + slot - 1, product 0x0007. ESP32 and CAN from the slot 5 V; the compute module from AUX 12 V through its own buck, switched by the ESP32. The microphone and the speaker are the audio card's, through the slot's I2S rail." (at 15 20 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "99965c55-ff06-5a34-a37f-b8e4f52589b8"))
  (symbol (lib_id "Connector_Generic:Conn_02x15_Odd_Even") (at 45 60 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "74169b3c-f5e3-5c9e-9c37-95267277836f")
    (property "Reference" "J1" (at 46.27 39.68 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "DigiDash slot" (at 46.27 80.32 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_2x15_P2.54mm_Horizontal" (at 45 60 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 45 60 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "Right-angle 2x15 header on the bottom edge (the slot pinout, docs/hardware/accessory_ports.md). Used: 5 V, GND, CAN, slot ID, I2S rail BCK / WS / MIC (inputs) and RET (a 3-state output), AUX 12 V / AUX GND (25-30). Not used: switched / constant 12 V, 3.3 V, WAKE, LAMP, REV, MCLK, audio bus" (at 45 60 0) (effects (font (size 1.27 1.27)) hide))
