  (text "CONSOLE BOARD  -  ESP32-S3-WROOM-1 + SSD1322 256x64 OLED (16-pin, SPI) + Back / View keys + two encoders + CAN node 0x13" (at 15 12 0) (effects (font (size 3 3)) (justify left top)) (uuid "02406b84-b276-50eb-b97a-0e64c43e5a97"))
  (text "Screen sits on standoffs above the board, soldered to J1. CAN cable J3 (5 V, CANH, CANL, GND) to a DigiDash cable port. Encoders are cabled to J4 / J5. J3-J6 are top entry, so the cables plug straight into the back of the board. USB-C is for programming (and bench power); in the car the board is powered from J3." (at 15 20 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "3f75db99-0766-5d5d-a752-132aee201c74"))
  (symbol (lib_id "Connector_Generic:Conn_02x08_Odd_Even") (at 60 60 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "3dd9284d-1472-54d1-9c19-429214e23ed6")
    (property "Reference" "J1" (at 61.27 49.84 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "OLED 2x8 socket" (at 61.27 72.7 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Connector_PinSocket_2.54mm:PinSocket_2x08_P2.54mm_Vertical" (at 60 60 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 60 60 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "SSD1322 256x64 OLED module (100 x 33.5 mm), 4-wire SPI: 1 GND, 2 VCC, 4 D0 CLK, 5 D1 DIN, 14 D/C, 15 RES, 16 CS; 3 and 6-13 open. Pinout measured on the module. Module pin n sits on socket pad 17 - n (even row on the outer edge, pin 2 at the bottom, checked on the module)" (at 60 60 0) (effects (font (size 1.27 1.27)) hide))
