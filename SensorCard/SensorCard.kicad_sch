  (text "SENSOR CARD  -  the DigiDash sensor pack on a slot card: ATmega2560 + MCP2515 / MCP2562 (CAN node 0x04, fixed) + FRAM odometer" (at 20 15 0) (effects (font (size 5 5)) (justify left top)) (uuid "8b7e5ec4-5404-5ae8-b90a-a95b0b4a6de3"))
  (text "Card for a DigiDash rev 2 slot, 80 x 60 mm, standing on edge (docs/hardware/accessory_ports.md). Any slot but slot 1 (kept for tall parts). Sender, speed and tach connectors on the top edge; ISP, FTDI and the sensor serial out on the left edge. Firmware: arduino/sketches/sensor_pack (port to this pin map, SensorCard/README.md)." (at 20 26 0) (effects (font (size 2 2)) (justify left top)) (uuid "95dd815d-4d00-5c94-ab6c-ac64389229e4"))
  (text "SLOT (J1, right-angle 2x15 on the bottom edge): 5 V, GND, CAN, switched 12 V (ignition sense, speed sensor feed), constant 12 V (battery sense), WAKE (hold the 5 V rail after key-off)" (at 20 45 0) (effects (font (size 2.5 2.5)) (justify left top)) (uuid "dfbf9d77-7f37-5122-87b7-8f0ffe78cb26"))
  (symbol (lib_id "Connector_Generic:Conn_02x15_Odd_Even") (at 48.26 83.82 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "4a57b98c-1464-571e-adc5-fe245115d622")
    (property "Reference" "J1" (at 49.53 63.5 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "DigiDash slot" (at 49.53 104.14 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_2x15_P2.54mm_Horizontal" (at 48.26 83.82 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 48.26 83.82 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "Right-angle 2x15 header on the bottom edge (the slot pinout, docs/hardware/accessory_ports.md). Used: 5 V, GND, CAN, switched 12 V (8), constant 12 V (10), WAKE (12). Not used: 3.3 V, slot ID (the node is fixed), LAMP, REV, I2S, audio, AUX 12 V" (at 48.26 83.82 0) (effects (font (size 1.27 1.27)) hide))
