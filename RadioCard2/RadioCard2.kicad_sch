  (text "AM/FM RADIO CARD rev B (all through-hole)  -  Si4737 breakout + PIC18F26Q83 + MCP2562: I2S audio to the audio card on the slot I2S rail, CAN for control" (at 15 12 0) (effects (font (size 3 3)) (justify left top)) (uuid "297a924c-ff35-5a59-800e-eef7a795cb5c"))
  (text "Card for a DigiDash slot, 80 x 60 mm, standing on edge (docs/hardware/accessory_ports.md), any slot. CAN node 0x14 + (slot - 1), product 0x0009 (docs/hardware/radio_card.md). 5 V from the slot only; 3.3 V on board.\nEvery part is through-hole for hand assembly, except J2 (edge-mount SMA, hand-soldered) and D2 (antenna ESD clamp, 1 x 0.6 mm SMD), which is not fitted." (at 15 20 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "1e4d0fc8-5bfc-58ec-87b7-8835b39e4a69"))
  (symbol (lib_id "Connector_Generic:Conn_02x15_Odd_Even") (at 45 55 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "76cadfd2-a22a-51a5-b02d-4ee8861208a4")
    (property "Reference" "J1" (at 46.27 34.68 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "DigiDash slot" (at 46.27 75.32 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_2x15_P2.54mm_Horizontal" (at 45 55 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 45 55 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "Right-angle 2x15 header on the bottom edge (the slot pinout, docs/hardware/accessory_ports.md). Used: 5 V, GND, CAN, slot ID, I2S rail BCK (15), WS (16) as inputs and RET (18) as a granted output, MCLK (24) only through the unfitted R to RCLK. Not used: MIC (17), 12 V, 3.3 V, WAKE, LAMP, REV, audio bus, AUX" (at 45 55 0) (effects (font (size 1.27 1.27)) hide))
