  (text "ANTENNA: J2 SMA, edge mount (the one part soldered on both faces of the board edge), on the top edge. FM (AN383 section 7, fig. 23): L1 56 nH from the antenna node to RF ground (bench-tune for the car whip and its cable, or leave it off), then 1 nF C0G to FMI. D2 (ESD clamp, under 1 pF; FMI / AMI absolute max 0.4 Vpk) has no through-hole version: its pads are here, not fitted. In its place: D4 / D5, two 1N5711 Schottky diodes back to back (about 0.4 V clamp, about 4 pF together; retune L1 with them in), behind SG1, a 0.25 mm PCB spark gap. AM: a ferrite loopstick (180-450 uH) on J5 between the AM node and ground, 470 nF to AMI. JP2 (open) would feed the SMA to AM too. Keep AM stray capacitance under 10 pF." (at 270 275 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "97d28d26-a403-57fb-a0b1-c284804df9a2"))
  (symbol (lib_id "Connector:Conn_Coaxial") (at 280 310 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "8867ee72-aac1-5591-b502-b0a572a6646a")
    (property "Reference" "J2" (at 280.254 306.952 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "Antenna (SMA)" (at 282.921 310 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Connector_Coaxial:SMA_Amphenol_132289_EdgeMount" (at 280 310 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 280 310 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "Amphenol RF 132289 SMA jack, edge mount, 1.6 mm board, on the top edge (as rev A; hand-soldered, the owner has one). For the car whip, a Motorola-to-SMA pigtail" (at 280 310 0) (effects (font (size 1.27 1.27)) hide))
    (pin "1" (uuid "a48c1127-6c4e-501e-b007-cb73a844bb44"))
