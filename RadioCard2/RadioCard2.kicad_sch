  (text "TUNER: the owner's Si4737-C40-GU breakout (FMBreakout.brd, 22.4 x 29.4 mm), plugged into J6 (1x8) and J7 (1x9) sockets, 17.78 mm apart. Si4737 = AM / FM / WB + RDS + digital audio out (no SW / LW; this card only uses FM and AM).\nIts pins as its silk reads (to check against the chip by continuity before first power): left header DOUT, DFS, P3 (GPO3 / DCLK), P2 (GPO2 / INT), P1 (GPO1), FMI, RFG, AMI; right header LOUT, ROUT, 3.3V, RCLK, SDIO, SCLK, SEN, RST, GND, both counted from the headphone-jack end.\nOn the breakout: the DBYP capacitor, 10k pull-ups on SDIO / SCLK to its 3.3 V, the headphone jack on LOUT / ROUT. No crystal (the reference comes from DCLK), no supply decoupling, no antenna coupling capacitors: those are here." (at 330 30 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "948f9279-c500-5fb1-b5fc-a6954b9ab987"))
  (symbol (lib_id "Connector_Generic:Conn_01x08") (at 340 75 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "2f8111fc-3cc0-5d76-9ac8-790e285179dc")
    (property "Reference" "J6" (at 340 64.84 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "Tuner L" (at 340 87.7 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Connector_PinSocket_2.54mm:PinSocket_1x08_P2.54mm_Vertical" (at 340 75 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 340 75 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "Tuner breakout, left header socket: 1 DOUT, 2 DFS, 3 P3 = GPO3 / DCLK, 4 P2 = GPO2 / INT, 5 P1 = GPO1 (open: it must be high or open at reset), 6 FMI, 7 RFG (RF ground), 8 AMI. Pin 1 at the headphone-jack end. 1x8 female header, 2.54 mm, 8.5 mm" (at 340 75 0) (effects (font (size 1.27 1.27)) hide))
    (pin "1" (uuid "03ee4811-de17-5313-adf4-81945b54699c"))
    (pin "2" (uuid "29fb66bd-04a6-5113-9de2-3ad5c87253d6"))
