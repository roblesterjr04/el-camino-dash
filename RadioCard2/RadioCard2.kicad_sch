  (label "+3V3A" (at 175 117.54 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7d8734ad-8f89-5a2c-a84e-3bccd7e7d005"))
  (text "MCU: PIC18F26Q83-I/SP (SPDIP-28, in a socket), as GPSCard2. Pin use (DS40002253 pin allocation and PPS tables):\nRC3 (pin 14) SCL1, RC4 (pin 15) SDA1 (the I2C module's default pins): the tuner.  RA2 (pin 4) tuner RST (100k to GND keeps it in reset).  RB0 (pin 21) tuner INT (GPO2, INT0).  RA4 (pin 6) RET buffer enable, ACTIVE LOW (10k pull-up keeps the buffer off at reset).\nRB2 (pin 23) CANTX by PPS, RB3 (pin 24) CANRX (its POR default).  RB4 (pin 25) U2TX, RB5 (pin 26) U2RX by PPS: debug serial (J4).\nRA1 (pin 3) ANA1: slot ID.  RC1 (pin 12) LED tuned, RC2 (pin 13) LED stereo / RDS.  RA7 / RA6 (pins 9 / 10): 16 MHz crystal, HS, 4x PLL = 64 MHz.\nConfig: JTAGEN off (JTAG shares RA0, RA5, RB3, RB5), LVP on. ICSP: MCLR (pin 1), ICSPCLK RB6 (27), ICSPDAT RB7 (28)." (at 190 30 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "2db2e52c-8e00-56d9-a750-d4dc2193153d"))
  (symbol (lib_id "RadioCard2:PIC18F26Q83-I_SP") (at 230 120 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "b2b0b61f-0967-5ceb-91dc-df80cc4ba617")
    (property "Reference" "U1" (at 218.57 93.33 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "PIC18F26Q83-I/SP" (at 241.43 93.33 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Package_DIP:DIP-28_W7.62mm_Socket" (at 230 120 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 230 120 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "Microchip PIC18F26Q83-I/SP: PIC18, 64 MHz, 64 KB flash, 4 KB RAM, CAN FD, I2C, 5 UARTs, 1.8-5.5 V, SPDIP-28 (in a 28-pin 0.3 in socket)" (at 230 120 0) (effects (font (size 1.27 1.27)) hide))
