    (property "Footprint" "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal" (at 340 205 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 340 205 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "Holds the tuner in reset until the PIC drives RST" (at 340 205 0) (effects (font (size 1.27 1.27)) hide))
