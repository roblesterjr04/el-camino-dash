  (label "AUX_GND" (at 55.16 77.78 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "18b6688a-68ba-5caa-a737-f09b7ef6a13b"))
  (text "Slot ID (pin 11): 10k to 3.3 V here, the slot's own resistor to GND on the main board, read on GPIO4 (ADC1).\nAUX GND (28-30) is NOT joined to GND on this card: on the main board the two meet only at NT1, at the power entry.\nJoining them here too would put a loop through NT1 and send AUX return current (this card's and other cards') through the logic ground.\nSo the LTE side (buck, 470 uF, core board) is all on AUX_GND, the ESP32 / CAN side on GND, and only logic signals cross between them." (at 75 40 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "9f6286b3-18f7-5559-ac0b-aef80759c1b5"))
  (symbol (lib_id "Device:R") (at 25 45 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "7d037df3-ded4-5293-95ef-8c47436f334e")
