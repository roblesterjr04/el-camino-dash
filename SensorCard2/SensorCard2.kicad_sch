  (text "SENSOR CARD rev B  -  the DigiDash sensor pack on a slot card: STM32G0B1KBU6 (FDCAN) + TJA1051 (CAN node 0x04, fixed) + FRAM odometer" (at 20 15 0) (effects (font (size 5 5)) (justify left top)) (uuid "58d4b057-5118-5a63-970d-7d32c1867fb2"))
  (text "Card for a DigiDash slot, 80 x 60 mm, standing on edge (docs/hardware/accessory_ports.md). Any slot but slot 1 (kept for tall parts). Sender, speed and tach connectors on the top edge; SWD, debug serial and the sensor serial out on the left edge. Rev B (2026-10-26) replaces rev A's ATmega2560 + MCP2515 with the GPS card's STM32G0B1 (built-in CAN), 3.3 V, two layers. The analog front end is ratiometric to the 3.3 V rail (the sender pull-ups come from +3V3), so the gauge counts are rev A's." (at 20 26 0) (effects (font (size 2 2)) (justify left top)) (uuid "2e2d652a-29ec-504a-a0ce-07f078b2fdbd"))
  (text "SLOT (J1, right-angle 2x15 on the bottom edge): 5 V, GND, CAN, switched 12 V (ignition sense, speed sensor feed), constant 12 V (battery sense), WAKE (hold the 5 V rail after key-off)" (at 20 45 0) (effects (font (size 2.5 2.5)) (justify left top)) (uuid "8de18c4a-0aa0-5b5c-81ce-f448010bfe90"))
  (symbol (lib_id "Connector_Generic:Conn_02x15_Odd_Even") (at 48.26 83.82 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "4b02adbf-a932-5239-917f-b17633b4301b")
    (property "Reference" "J1" (at 49.53 63.5 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "DigiDash slot" (at 49.53 104.14 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_2x15_P2.54mm_Horizontal" (at 48.26 83.82 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 48.26 83.82 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "Right-angle 2x15 header on the bottom edge (the slot pinout, docs/hardware/accessory_ports.md). Used: 5 V, GND, CAN, switched 12 V (8), constant 12 V (10), WAKE (12). Not used: the slot 3.3 V (the card makes its own), slot ID (the node is fixed), LAMP, REV, I2S, audio, AUX 12 V" (at 48.26 83.82 0) (effects (font (size 1.27 1.27)) hide))
