  (text "TUNER: Si4735-D60-GU (SSOP-24; same silicon as the -GM QFN, whose land pattern is not a stock KiCad footprint). Si4735 = AM / FM / SW / LW + RDS. NOT the Si4730 (no RDS)." (at 15 275 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "b748fc13-1745-5eed-b870-fe4423b03eb1"))
  (symbol (lib_id "RadioCard:Si4735-D60-GU") (at 330 60 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "6194edce-3de5-5fcb-af18-501b32ddfa0a")
    (property "Reference" "U4" (at 324.92 40.315 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "Si4735-D60-GU" (at 324.92 42.22 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Package_SO:SSOP-24_3.9x8.7mm_P0.635mm" (at 330 60 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 330 60 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "Skyworks (Silicon Labs) Si4735-D60-GU. Digital audio out is a SLAVE interface: DFS (pin 2) and DCLK (GPO3, pin 3) are inputs. Pins 10 / 11 unused: tie to GND (datasheet). 6 / 7 NC. GPO1 (5) left open: it must be high or open at reset (2-wire bus mode, internal pull-up). LOUT / ROUT unused: POWER_UP OPMODE 0xB0 (digital only; 0xB5 analog + digital is not offered on the Si4735 in FM, AN332 p.15)" (at 330 60 0) (effects (font (size 1.27 1.27)) hide))
    (pin "1" (uuid "a12c7e92-b903-5391-993b-901c904f6d62"))
    (pin "2" (uuid "ae399be2-b26e-50d1-a27e-75609517ce16"))
