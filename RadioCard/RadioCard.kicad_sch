    (property "Value" "0" (at 60 320 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 60 320 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 60 320 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "UNFITTED. Fallback reference: the rail MCLK into RCLK (REFCLK_PRESCALE 375, RCLKSEL = RCLK)" (at 60 320 0) (effects (font (size 1.27 1.27)) hide))
    (pin "1" (uuid "d7624abb-4bb4-51ff-8f46-fb17bdd799f1"))
