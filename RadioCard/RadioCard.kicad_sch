  (text "TUNER: Si4735-D60-GU (SSOP-24; same silicon as the -GM QFN, whose land pattern is not a stock KiCad footprint). Si4735 = AM / FM / SW / LW + RDS. NOT the Si4730 (no RDS)." (at 15 275 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "d20d5e6b-e879-5d33-8d60-147328abe4df"))
  (symbol (lib_id "RadioCard:Si4735-D60-GU") (at 330 60 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "22287efd-1f7f-574d-ab22-1836e8de903f")
    (property "Reference" "U5" (at 324.92 40.315 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "Si4735-D60-GU" (at 324.92 42.22 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Package_SO:SSOP-24_3.9x8.7mm_P0.635mm" (at 330 60 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 330 60 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "Silicon Labs Si4735-D60-GU. Digital audio out is a SLAVE interface: DFS (pin 2) and DCLK (GPO3, pin 3) are inputs. Pins 10 / 11 unused: tie to GND (datasheet). 6 / 7 NC. GPO1 (5) left open: it must be high or open at reset (2-wire bus mode, internal pull-up)" (at 330 60 0) (effects (font (size 1.27 1.27)) hide))
