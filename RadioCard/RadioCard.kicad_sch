    (property "Footprint" "Package_DFN_QFN:QFN-32-1EP_5x5mm_P0.5mm_EP3.45x3.45mm" (at 210 120 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 210 120 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "ST STM32G0B1KBU6: Cortex-M0+ 64 MHz, 128 KB flash, 144 KB RAM, FDCAN, UFQFPN-32 5 x 5 mm (exposed pad = VSS)" (at 210 120 0) (effects (font (size 1.27 1.27)) hide))
