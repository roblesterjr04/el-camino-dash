  (text "AM/FM RADIO CARD  -  Si4735-D60 tuner + STM32G0B1KBU6 + MCP2562: I2S audio to the audio card on the slot I2S rail, CAN for control" (at 15 12 0) (effects (font (size 3 3)) (justify left top)) (uuid "8f7dd0b2-a847-5bb9-9961-f23ba87279c3"))
  (text "Card for a DigiDash slot, 80 x 60 mm, standing on edge (docs/hardware/accessory_ports.md), any slot. CAN node 0x14 + (slot - 1), product 0x0009 (docs/hardware/radio_card.md). 5 V from the slot only; 3.3 V on board.\nSCHEMATIC STATUS: first draft. Items marked PROVISIONAL need AN332 / AN383 (the AM / whip network, the I2C address, which RCLK frequencies the tuner accepts)." (at 15 20 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "3e67a49e-0b68-5fd7-b9e3-23472e5a33f5"))
  (symbol (lib_id "Connector_Generic:Conn_02x15_Odd_Even") (at 45 55 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "daa8de8e-942c-528e-a29e-0ded31247ba1")
    (property "Reference" "J1" (at 46.27 34.68 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "DigiDash slot" (at 46.27 75.32 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_2x15_P2.54mm_Horizontal" (at 45 55 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 45 55 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "Right-angle 2x15 header on the bottom edge (the slot pinout, docs/hardware/accessory_ports.md). Used: 5 V, GND, CAN, slot ID, I2S rail BCK (15), WS (16) as inputs and RET (18) as a granted output. Not used: MIC (17), MCLK (24), 12 V, 3.3 V, WAKE, LAMP, REV, audio bus, AUX" (at 45 55 0) (effects (font (size 1.27 1.27)) hide))
