  (text "GPS CARD  -  STM32G0B1KBU6 + MCP2562: reads a remote GPS puck (UART) and sends position / motion / time on CAN" (at 15 12 0) (effects (font (size 3 3)) (justify left top)) (uuid "88a5545e-5a73-5cd9-9e5c-bb0d3b100b1b"))
  (text "Card for a DigiDash slot, 80 x 60 mm, standing on edge (docs/hardware/accessory_ports.md), any slot. CAN node 0x14 + (slot - 1), product 0x0005, IDs 0x222-0x226 (docs/hardware/gps_card.md). 5 V from the slot only; 3.3 V on board. No radio, no RF parts." (at 15 20 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "5407d98a-cfd5-5962-ad9e-a8962d7b4abc"))
  (symbol (lib_id "Connector_Generic:Conn_02x15_Odd_Even") (at 45 55 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "3c1bb292-c91f-5b33-9944-dfee985f653f")
