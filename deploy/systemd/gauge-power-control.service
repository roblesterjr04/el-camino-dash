[Unit]
Description=Gauge Power Control Listener
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/el-camino-dash
ExecStart=/bin/bash -lc 'set -euo pipefail; LOG=/boot/elc-power-control.log; [ -d /boot/firmware ] && LOG=/boot/firmware/elc-power-control.log; touch "$LOG"; echo "[elc] gauge-power-control start $(date -Is)" >> "$LOG"; exec /opt/el-camino-dash/.venv/bin/python /opt/el-camino-dash/scripts/power_control_listener.py --signal-pin 16 --confirm-pin 12 --debounce-ms 80 --poll-interval-ms 20 --startup-ignore-ms 45000 >>"$LOG" 2>&1'
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
