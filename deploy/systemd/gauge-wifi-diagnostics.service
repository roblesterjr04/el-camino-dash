[Unit]
Description=Capture Wi-Fi runtime diagnostics to bootfs
After=NetworkManager.service elc-wifi-radio-on.service
Wants=NetworkManager.service elc-wifi-radio-on.service
ConditionPathExists=!/etc/elc-disable-wifi-diag

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/el-camino-dash/scripts/wifi_runtime_diagnostics.sh
TimeoutStartSec=240
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
