[Unit]
Description=Start Wi-Fi and Bluetooth after dashboard
After=gauge-cluster-hdmi.service
Wants=gauge-cluster-hdmi.service
ConditionPathExists=!/etc/elc-disable-late-connectivity

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -lc 'sleep 8; systemctl start bluetooth.service systemd-resolved.service systemd-networkd.service wpa_supplicant.service || true'

[Install]
WantedBy=multi-user.target
