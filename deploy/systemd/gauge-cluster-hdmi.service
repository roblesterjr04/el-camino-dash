[Unit]
Description=Gauge Cluster Dashboard (HDMI)
After=graphical.target display-manager.service
Wants=graphical.target display-manager.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/el-camino-dash
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DISPLAY_MODE=hardware
Environment=SDL_VIDEODRIVER=x11
Environment=SDL_AUDIODRIVER=alsa
Environment=PYTHONPATH=/opt/el-camino-dash/src
ExecStart=/bin/bash -lc 'export DISPLAY=:0; export XAUTHORITY=/home/pi/.Xauthority; export XDG_RUNTIME_DIR=/run/user/1000; export SDL_VIDEODRIVER=x11; export SDL_AUDIODRIVER=alsa; until [ -S /tmp/.X11-unix/X0 ] && [ -f /home/pi/.Xauthority ] && xset q >/dev/null 2>&1; do sleep 1; done; cd /opt/el-camino-dash; exec /opt/el-camino-dash/.venv/bin/python /opt/el-camino-dash/src/main.py --config /opt/el-camino-dash/config/dashboard.hdmi5.yaml'
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
