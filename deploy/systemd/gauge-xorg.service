[Unit]
Description=Gauge Xorg Display Server
After=local-fs.target systemd-modules-load.service
Before=gauge-cluster-hdmi.service
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/bin/Xorg :0 -nolisten tcp -nocursor vt1 -ac
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
