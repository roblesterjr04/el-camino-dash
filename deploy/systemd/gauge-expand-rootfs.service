[Unit]
Description=Expand root filesystem to full media size
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target gauge-cluster-hdmi.service gauge-power-control.service
ConditionPathExists=!/var/lib/el-camino-dash/rootfs-expanded

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/elc-expand-rootfs.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
