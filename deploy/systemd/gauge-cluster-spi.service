[Unit]
Description=Gauge Cluster Dashboard (SPI)
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/el-camino-dash
Environment=SDL_VIDEODRIVER=dummy
Environment=HEADLESS=1
Environment=PYTHONPATH=/opt/el-camino-dash/src
ExecStart=/bin/bash -lc 'set -euo pipefail; LOG=/boot/elc-gauge-spi.log; [ -d /boot/firmware ] && LOG=/boot/firmware/elc-gauge-spi.log; touch "$LOG"; echo "[elc] gauge-cluster-spi start $(date -Is)" >> "$LOG"; exec /opt/el-camino-dash/.venv/bin/python /opt/el-camino-dash/src/main.py --config /opt/el-camino-dash/config/dashboard.spi.yaml --render-mode spi --headless >>"$LOG" 2>&1'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
