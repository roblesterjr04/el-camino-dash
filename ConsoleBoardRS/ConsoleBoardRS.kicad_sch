    (property "Value" "Select knob (RJ9)" (at 240 307.62 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "ConsoleBoardRS:RJ9_Assmann_A-2014-3-4-N-T-R_Vertical" (at 240 300 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 240 300 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "RJ9 4P4C top-entry jack, Assmann WSW A-2014-3-4-N-T-R (footprint pins 1-4 = jack contacts 1-4): 1 black GND, 2 red encoder, 3 green switches, 4 yellow GND" (at 240 300 0) (effects (font (size 1.27 1.27)) hide))
