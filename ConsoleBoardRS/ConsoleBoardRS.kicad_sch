  (text "CONSOLE BOARD, RETROSOUND KNOBS  -  ESP32-S3-WROOM-1 + SSD1322 256x64 OLED (16-pin, SPI) + two RetroSound knobs on RJ9 + CAN node 0x13" (at 15 12 0) (effects (font (size 3 3)) (justify left top)) (uuid "2f1acf90-f188-5bdd-8c87-76c08aeddb42"))
  (text "Screen sits on standoffs above the board, soldered to J1. CAN cable J3 (5 V, CANH, CANL, GND) to a DigiDash cable port. The two knobs (RetroSound 258A style, resistor ladders) plug into RJ9 jacks J4 / J5. USB-C is for programming (and bench power); in the car the board is powered from J3." (at 15 20 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "5cb46bcd-ff43-5c1c-be37-34aa6e09ae27"))
  (symbol (lib_id "Connector_Generic:Conn_02x08_Odd_Even") (at 60 60 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "4ed3dfae-dd5e-541a-ac2a-26960e4f973e")
    (property "Reference" "J1" (at 61.27 49.84 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Value" "OLED 2x8 socket" (at 61.27 72.7 0) (effects (font (size 1.27 1.27)) (justify left)))
    (property "Footprint" "Connector_PinSocket_2.54mm:PinSocket_2x08_P2.54mm_Vertical" (at 60 60 0) (effects (font (size 1.27 1.27)) hide))
    (property "Datasheet" "~" (at 60 60 0) (effects (font (size 1.27 1.27)) hide))
    (property "Description" "SSD1322 256x64 OLED module (100 x 33.5 mm), 4-wire SPI: 1 GND, 2 VCC, 4 D0 CLK, 5 D1 DIN, 14 D/C, 15 RES, 16 CS; 3 and 6-13 open. Pinout measured on the module. Module pin n sits on socket pad 17 - n (even row on the outer edge, pin 2 at the bottom, checked on the module)" (at 60 60 0) (effects (font (size 1.27 1.27)) hide))
