  (wire (pts (xy 490.22 412.75) (xy 490.22 415.29)) (stroke (width 0) (type default)) (uuid "29f0a9c0-be6e-593f-8ec2-2ccf4e2fbe8c"))
  (label "SER_3V3" (at 490.22 415.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "cbd28ae7-380a-570c-8b1f-a4f33a74c14b"))
  (text "VIDEO: a TVP5150 breakout module on J8 (2x10 socket; the module carries its own video input, crystal and regulators) -> 8-bit BT.656 to the center screen's camera pins (same J1 pins as rev 1 and 2). I2C on the cluster bus. JP1 straps the module's VCC to 5 V or 3.3 V. J10 brings PCLK / RESET on wires." (at 1220 45 0) (effects (font (size 2.5 2.5)) (justify left top)) (uuid "7b85dafe-c2dd-5f75-b0e8-d582caf01b0d"))
  (text "J8 pin order is the module's: 1 VCC, 2 GND, 3 SCL, 4 SDA, 5 VSYNC, 6 HSYNC, 7-8 n.c., 9-16 D7..D0, 17 n.c., 18 FID, 19 INT, 20 ID. The module has no pixel-clock pin on its header: J10 pin 1 is the center screen's PCLK (J1 pin 25), for a wire from the module's PCLK point; J10 pin 2 is the center's reset line (GPIO52) for the module's RESET, if it has one." (at 1220 51 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "74d3e8c6-ea94-5ebc-8858-7515ea94cf8c"))
  (symbol (lib_id "Connector_Generic:Conn_02x10_Odd_Even") (at 1247.14 76.2 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "81290bde-15d4-5a6c-8084-54cb3085451a")
